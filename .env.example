# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO
BRAIN_API_HOST=127.0.0.1
BRAIN_API_PORT=8080

# PostgreSQL: use a local Linux filesystem for database volumes.
DATABASE_URL=postgresql+psycopg://brain:change-me@127.0.0.1:5432/personal_ai_brain

# Optional local model endpoint. Keep it on a trusted network.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=

# Security defaults: keep external model egress disabled until explicitly configured.
ALLOW_EXTERNAL_MODEL_EGRESS=false
